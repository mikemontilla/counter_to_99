ldc_set_vcc -bank 0 3.3
ldc_set_vcc -bank 1 3.3
ldc_set_vcc -bank 2 3.3
ldc_set_vcc -bank 3 1.2
ldc_set_vcc -bank 4 1.2
ldc_set_vcc -bank 5 1.8
ldc_set_vcc -bank 6 3.3
ldc_set_vcc -bank 7 3.3

ldc_set_location -site {K3} [get_ports {segments[6]}]
ldc_set_location -site {H2} [get_ports {segments[5]}]
ldc_set_location -site {N2} [get_ports {segments[4]}]
ldc_set_location -site {N1} [get_ports {segments[3]}]
ldc_set_location -site {M1} [get_ports {segments[2]}]
ldc_set_location -site {L2} [get_ports {segments[1]}]
ldc_set_location -site {L1} [get_ports {segments[0]}]
ldc_set_location -site {M3} [get_ports digit_selection]
ldc_set_location -site {D4} [get_ports clock]
ldc_set_location -site {D12} [get_ports reset]

ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {segments[*]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports clock]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33 PULLMODE=UP} [get_ports reset]